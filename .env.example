# Copy to .env and fill in. Never commit .env.

# --- Elisa account (the owner's own sign-in) ---------------------------------
ELISA_BASE_URL=https://www.sosi1.com
ELISA_EMAIL=
ELISA_PASSWORD=
# Instead of the two lines above you can point at secret files:
# ELISA_EMAIL_FILE=/run/secrets/elisa_email
# ELISA_PASSWORD_FILE=/run/secrets/elisa_password

# --- Accepting -----------------------------------------------------------------
# true  = find the Accept button but never click it (safe default)
# false = really accept
TEST_MODE=true
# The first run (and the first run after a state reset) only records what is
# already open. Set true to accept those too.
APPLY_ON_FIRST_RUN=false
# Safety cap on Accept clicks per day (0 = no cap).
MAX_APPLIES_PER_DAY=10

# --- Checking ----------------------------------------------------------------------
# Quick check: every this many seconds the bot asks Elisa how many open work orders there are
# in the months it checks (one small request, the one the calendar page itself makes) and reads
# the calendar at once when that number goes up. 0 turns quick checks off. Elisa limits this
# request strictly: every 10 s drew refusals within minutes, every 20 s none.
QUICK_CHECK_SECONDS=20
# How often the bot reads one calendar month (the on/off page can change it). With quick checks
# on, 60 s keeps the load on Elisa about where reading every 20 s without them was; reading every
# 15 s drew about 3 "too many requests" refusals an hour.
POLL_SECONDS=60
# Never read the calendar more often than this.
MIN_POLL_SECONDS=15
# Sign out of Elisa when the bot is switched off.
LOGOUT_WHEN_OFF=true
# Most sign-ins per rolling hour; past that the bot waits instead of signing in again.
MAX_SIGN_INS_PER_HOUR=6
# Signing in, or reloading the page after a failed check, is a burst of requests; wait this
# long after one before the next check.
QUIET_AFTER_SIGN_IN_SECONDS=90
# How many months to look at: this month plus the next ones (3 = this month + 2 more).
MONTHS_TO_CHECK=3

# --- Outside monitor ------------------------------------------------------------------
# Optional heartbeat URL (for example a healthchecks.io check, period 5 min, grace 5 min).
# The bot pings it while it is working or deliberately switched off; when the pings stop,
# the monitor emails you. Keep it private: anyone with the URL can fake "alive" pings.
HEARTBEAT_URL=
# HEARTBEAT_URL_FILE=/run/secrets/heartbeat_url
HEARTBEAT_SECONDS=60

# --- Email alerts ---------------------------------------------------------------------
# The client's alert inbox is on AgentMail:
#   SMTP_PROVIDER=agentmail
#   SMTP_USERNAME=anya-alerts@agentmail.to
#   SMTP_PASSWORD=<an AgentMail API key, from console.agentmail.to → API Keys>
# For a normal mailbox pick its provider and use an "app password" (Gmail, AOL, Yahoo and
# iCloud need one from the account's security settings, not the normal password).
# Providers: agentmail, gmail, outlook, aol, yahoo, icloud. For anything else leave it
# empty and fill in SMTP_HOST / SMTP_PORT / SMTP_SSL / SMTP_STARTTLS.
SMTP_PROVIDER=
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# Sender address (defaults to SMTP_USERNAME) and the name shown as the sender.
# SMTP_FROM=
SMTP_FROM_NAME=Elisa Bot
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SSL=false
# SMTP_STARTTLS=true
# Comma-separated list of recipients.
ALERT_EMAIL_TO=
# Also email when an opening was taken by someone else first.
NOTIFY_MISSED=true
# Also email when a new opening was skipped because the owner is already booked then.
NOTIFY_SKIPPED=true

# --- On/off page -------------------------------------------------------------------------
# Password for the page, and a random key (32+ characters) that signs its sign-in cookie.
# Make a key with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROL_PASSWORD=
CONTROL_SECRET_KEY=
# CONTROL_PASSWORD_FILE=/run/secrets/control_password
# CONTROL_SECRET_KEY_FILE=/run/secrets/control_secret_key
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
# Keep true when the page is served over HTTPS; set false only for local testing over http.
CONTROL_COOKIE_SECURE=true

# --- General -----------------------------------------------------------------------
TIMEZONE=America/New_York
DATA_DIR=data
HEADLESS=true
LOG_LEVEL=INFO
# Optional JSON file overriding page selectors (see src/elisa_bot/site/selectors.py).
# SELECTORS_FILE=selectors.json
